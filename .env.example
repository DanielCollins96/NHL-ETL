DB_CONNECTION=postgresql+psycopg2://user:password@host:5432/dbname
# DB_CONNECTION_2=postgresql+psycopg2://user:password@host2:5432/dbname

# Pipeline selection examples: all, today, schedule_now, games, gamecenter_only, games_gamecenter
ETL_PIPELINES=today

# Used by ETL_PIPELINES=today or schedule_now.
SCHEDULE_LOOKBACK_DAYS=7
# SCHEDULE_END_DATE=2026-06-12

