DB_CONNECTION=postgresql+psycopg2://user:password@host:5432/dbname
# DB_CONNECTION_2=postgresql+psycopg2://user:password@host2:5432/dbname

# Pipeline selection examples: all, today, schedule_now, games, gamecenter_only, games_gamecenter
ETL_PIPELINES=today

# Used by ETL_PIPELINES=today or schedule_now.
SCHEDULE_LOOKBACK_DAYS=7
# SCHEDULE_END_DATE=2026-06-12

# Optional gamecenter controls.
# GAMECENTER_GAME_IDS=2025030413,2025030414
# GAMECENTER_FETCH_BATCH_SIZE=50
# GAMECENTER_FETCH_BATCH_DELAY=0.1

# Read-model S3 publish (used by publish_read_models_to_s3.py after the DB ETL).
# READ_MODEL_S3_BUCKET=your-bucket
# READ_MODEL_S3_PREFIX=hockey-read-models
# READ_MODEL_EXPORT_GROUPS=games,players,teams,seasons,indexes
# CLOUDFRONT_DISTRIBUTION_ID=
# CLOUDFRONT_INVALIDATION_MODE=none
